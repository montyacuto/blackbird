  "source_basis": {
    "incident": "Clinejection (2025-12 to 2026-02)",
    "sources": [
      "https://adnanthekhan.com/posts/clinejection/",
      "https://cline.bot/blog/post-mortem-unauthorized-cline-cli-npm"
    ],
    "retained": [
      "untrusted issue title reaches a triage agent with a powerful tool",
      "a lower-privilege workflow can affect a cache read by a publishing workflow",
      "an exposed publishing credential can authorize an unintended package release"
    ],
    "transformed": [
      "all target identities, packages, credentials, workflows, and registry are fictional",
      "cache and helper effects are typed state transitions without code execution",
      "incident evidence states are distinct from synthetic runtime events"
    ],
    "invented": [
      "case-specific benign and decoy workflows",
      "synthetic credentials, package artifacts, sensors, costs, and in-memory publication records"
    ]
  },
